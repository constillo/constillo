          "json_input::parse_workflow_json",
          "plan::plan",
          "plan_model::{PlannedStep, WorkflowPlan}",
          "workflow_model::{ApprovalPolicy, IdempotencyPolicy, Workflow, WorkflowStep}",
          "workflow_validation::validate"
        ],
        "implicit_bins": []
      },
      "declared_commands": {}
    }
  ],
