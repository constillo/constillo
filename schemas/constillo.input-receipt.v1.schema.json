{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constillo.example/schemas/constillo.input-receipt.v1.schema.json",
  "title": "Constillo deterministic input receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_id",
    "request_id",
    "input_digest",
    "workflow_id",
    "workflow_version",
    "correlation_id",
    "artifact_digest_sha256",
    "accepted",
    "executable",
    "external_actions",
    "plan"
  ],
  "properties": {
    "schema_version": {
      "const": "constillo.input-receipt/v1"
    },
    "receipt_id": {
      "type": "string",
      "pattern": "^receipt-[a-f0-9]{24}$"
    },
    "request_id": {
      "$ref": "#/$defs/identifier"
    },
    "input_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "workflow_id": {
      "$ref": "#/$defs/identifier"
    },
    "workflow_version": {
      "$ref": "#/$defs/semanticVersion"
    },
    "correlation_id": {
      "$ref": "#/$defs/identifier"
    },
    "artifact_digest_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "accepted": {
      "const": true
    },
    "executable": {
      "const": false
    },
    "external_actions": {
      "const": false
    },
    "plan": {
      "$ref": "#/$defs/plan"
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "semanticVersion": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "workflow_id",
        "workflow_version",
        "mode",
        "executable",
        "steps"
      ],
      "properties": {
        "schema_version": {
          "const": "constillo.plan/v1"
        },
        "workflow_id": {
          "$ref": "#/$defs/identifier"
        },
        "workflow_version": {
          "$ref": "#/$defs/semanticVersion"
        },
        "mode": {
          "const": "plan-only"
        },
        "executable": {
          "const": false
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/plannedStep"
          }
        }
      }
    },
    "plannedStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "level",
        "step_id",
        "action",
        "depends_on",
        "external_action",
        "approval_gate",
        "idempotency_key"
      ],
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "level": {
          "type": "integer",
          "minimum": 0
        },
        "step_id": {
          "$ref": "#/$defs/identifier"
        },
        "action": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "depends_on": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "external_action": {
          "const": false
        },
        "approval_gate": {
          "oneOf": [
            {
              "$ref": "#/$defs/identifier"
            },
            {
              "type": "null"
            }
          ]
        },
        "idempotency_key": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
